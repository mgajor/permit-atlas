# Only software, synthetic fixtures, and curated documentation are publishable.
/*
!/.gitignore
!/package.json
!/package-lock.json
!/vite.config.mjs
!/desktop/
!/desktop/**
!/server/
!/server/**
!/web/
!/web/**
!/samples/
!/samples/**
!/.github/
!/.github/**
!/LICENSE
!/NOTICE
!/THIRD_PARTY_NOTICES.txt
!/README.md
!/PROCESS.md
!/SECURITY.md
!/PRIVACY.md
!/CONTRIBUTING.md
!/scripts/
!/scripts/**

# Defense in depth within allowed directories
**/.env
**/.env.*
**/*.sqlite
**/*.sqlite-*
**/*outbox*.json
**/*credential*
**/*.pem
**/*.key
**/node_modules/
**/.DS_Store
